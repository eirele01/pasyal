# ──────────────────────────────────────────────────────────────────────
# Pasyal — environment variables (SPEC §1.6)
#
# Copy this file to `.env` (git-ignored) and fill in real values.
# NEVER commit real keys — only this .env.example with placeholders is
# committed (SPEC §1.5 rule 6).
# ──────────────────────────────────────────────────────────────────────

# Supabase project URL — non-secret (SPEC §1.6).
SUPABASE_URL=https://foiltfxiazkfdzuwbvio.supabase.co

# Supabase publishable (anon) key — browser-safe, protected by RLS.
# Dashboard → Settings → API → Project API keys → "publishable" key.
# NOTE: the app runs WITHOUT this (placeholder key) but sign-in and all
# data access then fail with Supabase's "No API key found in request" —
# copy this file to .env and paste the real key before `npm run dev`.
SUPABASE_KEY=your-publishable-key-here

# Supabase secret key — SERVER ONLY (SPEC §1.5 rule 8).
# Must never appear in the browser bundle, client code, logs or git.
# Not used by M0 app code; reserved for future Nuxt server routes (SPEC §8.2).
SUPABASE_SECRET_KEY=your-secret-key-here

# Direct Postgres connection string — migration tooling only (SPEC §1.6).
# The application itself never connects to the database directly; all app
# data access goes through supabase-js with Row Level Security.
# URL-encode special characters in the password (for example @, #, /).
DIRECT_URL=postgresql://postgres:YOUR_PASSWORD@db.foiltfxiazkfdzuwbvio.supabase.co:5432/postgres

# ── M3: map tiles (FR-MAP-01, EI-06) ─────────────────────────────────
# Browser-public: the browser loads tiles directly from this URL template.
# The default is the OpenStreetMap tile server, which is fine for local
# development but MUST NOT carry production traffic (SPEC EI-06).
#
# Q-16 decision (owner, M4 session): Stadia Maps free tier.
#   * localhost works WITHOUT a key (strict rate limits apply).
#   * Production (pasyal.vercel.app) needs EITHER an API key appended to
#     the URL OR domain-based authentication registered in the Stadia
#     Maps dashboard (add your domains under Authentication). A key used
#     in a tile URL is necessarily browser-visible — restrict it to your
#     domains in the dashboard (NFR-SEC-10) and keep the required
#     attribution below.
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_ATTRIBUTION=© OpenStreetMap contributors
# Production template (uncomment, add your key, and set the attribution):
# MAP_TILE_URL=https://tiles.stadiamaps.com/tiles/alidade_smooth/{z}/{x}/{y}{r}.png?api_key=YOUR_STADIA_MAPS_KEY
# MAP_TILE_ATTRIBUTION=&copy; <a href="https://stadiamaps.com/">Stadia Maps</a> &copy; <a href="https://openmaptiles.org/">OpenMapTiles</a> &copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors

# ── M3: place search (FR-MAP-03, §19.1, NFR-SEC-07) ──────────────────
# SERVER-ONLY settings for the /api/places/search proxy. The provider is
# configurable because the geocoder half of Q-16 is still open.
#   photon   — default, no API key needed (photon.komoot.io)
#   geoapify — free tier; needs GEOCODER_API_KEY (server-side secret)
GEOCODER_PROVIDER=photon
# GEOCODER_BASE_URL=https://photon.komoot.io
# GEOCODER_API_KEY=your-geoapify-key-here

# ── M4: live location thresholds (FR-LOC-04/08/16 "configurable") ────
# All optional; defaults mirror app/lib/location.ts. Tune per environment
# (for example a slower cadence for battery-limited pilots) — no rebuild
# needed when set in the Vercel dashboard.
# LOC_MOVING_INTERVAL_MS=5000       # broadcast at most every … while moving
# LOC_STATIONARY_INTERVAL_MS=30000  # heartbeat while stationary
# LOC_MOVEMENT_THRESHOLD_M=10       # movement that counts as "moving"
# LOC_PERSIST_INTERVAL_MS=45000     # persisted write cadence (30–60 s band)
# LOC_STALE_AFTER_MS=120000         # pin greyed after 2 min without update
# LOC_HIDE_AFTER_MS=1800000         # pin hidden after 30 min
# LOC_LOW_ACCURACY_M=100            # accuracy worse than this is flagged
